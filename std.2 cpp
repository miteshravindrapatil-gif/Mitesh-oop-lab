#include <iostream>
using namespace std;

class Student
{
public:
    int id;
    static int count;

    Student(int i)
    {
        id = i;
        count++;
    }

    void display()
    {
        cout << "Student ID: " << id << endl;
    }
};

int Student::count = 0;

int main()
{
    Student s1(101);
    Student s2(102);
    Student s3(103);

    s1.display();
    s2.display();
    s3.display();

    cout << "Total Students: " << Student::count << endl;

    return 0;
}